# ============================================================
# OPTIMAL CLASSROOM ALLOCATION SYSTEM - Environment Variables
# Copy this file to .env and adjust values for local use.
# Never commit the real .env file.
# ============================================================

# ---- Server ----
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000/api

# ---- Security (JWT) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# ---- Database (SQLite) ----
DB_PATH=./data/classroom_alloc.db

# ---- Seed / Demo ----
SEED_DEMO_DATA=true
