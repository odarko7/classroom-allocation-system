# ============================================================
# OPTIMAL CLASSROOM ALLOCATION SYSTEM - Environment Variables
# Copy this file to .env and adjust values for local use.
# Never commit the real .env file.
# ============================================================

# ---- Server ----
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000/api
# Frontend origin used to build password-reset links (leave as default for local dev)
FRONTEND_URL=http://localhost:5173

# ---- Security (JWT) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# ---- Database (SQLite) ----
DB_PATH=./data/classroom_alloc.db

# ---- Email / SMTP (optional) ----
# When SMTP_HOST is set, password-reset links are emailed to users.
# When left empty, the app shows the reset token directly on the login page
# (and admins can generate tokens from the Users page).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Classroom Allocation <no-reply@localhost>

# ---- Seed / Demo ----
SEED_DEMO_DATA=true
