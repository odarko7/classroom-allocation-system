{
  "name": "classroom-allocation-backend",
  "version": "1.0.0",
  "description": "Optimal Classroom Allocation System - REST API backend",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:init": "node src/db/init.ts",
    "db:seed": "node src/db/seed.ts",
    "test": "node --test test/",
    "test:algorithm": "node --test test/algorithm.test.ts",
    "eval": "node test/evaluation.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4"
  }
}
